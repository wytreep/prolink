# URL base de la API de ProLink.
# Si se omite, la app intenta usar el host de Metro en el puerto 4000
# (funciona en emulador y en un celular conectado a la misma red).
# Para un dispositivo físico puedes fijarla con la IP de tu PC:
# EXPO_PUBLIC_API_URL=http://192.168.1.20:4000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
