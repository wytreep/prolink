NODE_ENV=development
PORT=4000
# Nunca versionar el .env real. Usar usuario de BD con minimo privilegio.
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/prolink
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h
